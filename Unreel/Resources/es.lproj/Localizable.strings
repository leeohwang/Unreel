"The last check found you logged out. Open Unreel and log in to Instagram." = "La última comprobación vio que no has iniciado sesión. Abre Unreel e inicia sesión en Instagram.";
"The last check couldn't load your inbox in time. It will try again." = "La última comprobación no pudo cargar tus mensajes a tiempo. Lo volverá a intentar.";
"Instagram changed its inbox page. A fix will arrive automatically." = "Instagram cambió su página de mensajes. Llegará un arreglo automáticamente.";
"Tap here to open Unreel." = "Toca aquí para abrir Unreel.";

/* Setup guides */
"How to set it up" = "Cómo configurarlo";
"Set it up" = "Configurar";
"Open Unreel from Instagram" = "Abrir Unreel desde Instagram";
"With a Shortcuts automation, opening Instagram or tapping one of its notifications takes you straight to Unreel. Takes about a minute." = "Con una automatización de Atajos, abrir Instagram o tocar una de sus notificaciones te lleva directo a Unreel. Tarda un minuto.";
"Open Shortcuts" = "Abrir Atajos";
"Close" = "Cerrar";
"Step %lld" = "Paso %lld";
"Turn on the lock" = "Activa el bloqueo";
"In Unreel, tap ≡, then turn on Lock the Instagram app." = "En Unreel, toca ≡ y activa Bloquear la app de Instagram.";
"Allow Screen Time" = "Permite Tiempo de uso";
"Pick Instagram" = "Elige Instagram";
"That's it" = "Listo";
"Tap Continue, confirm with Face ID or your passcode, then allow notifications." = "Toca Continuar, confirma con Face ID o tu código y permite las notificaciones.";
"Tap Choose Activities, open Social, tick Instagram, then tap Done." = "Toca Elegir actividades, abre Redes sociales, marca Instagram y toca OK.";
