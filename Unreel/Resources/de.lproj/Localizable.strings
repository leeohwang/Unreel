/* Message alerts */
"Message alerts" = "Nachrichten-Hinweise";
"Alert me about new messages" = "Bei neuen Nachrichten benachrichtigen";
"Background App Refresh is off for Unreel, so it can't check. Turn it on in the Settings app under General > Background App Refresh." = "Die Hintergrundaktualisierung ist für Unreel aus, daher kann es nicht nachsehen. Schalte sie in den Einstellungen unter Allgemein > Hintergrundaktualisierung ein.";
"Last checked" = "Zuletzt geprüft";
"Unreel checks your messages when iOS lets it run in the background, so alerts can be an hour or more late, and stop if you swipe Unreel away. Keeping your iPhone charging overnight gives it more chances. The check happens on this iPhone; nothing is sent anywhere. For instant alerts, keep the Instagram app and lock it with Screen Time below." = "Unreel sieht nach deinen Nachrichten, wenn iOS es im Hintergrund laufen lässt. Hinweise können daher eine Stunde oder mehr zu spät kommen und hören auf, wenn du Unreel wegwischst. Wenn dein iPhone über Nacht lädt, hat es mehr Gelegenheiten. Die Prüfung läuft auf diesem iPhone; nichts wird irgendwohin gesendet. Für sofortige Hinweise behalte die Instagram-App und sperre sie unten mit Bildschirmzeit.";
"Notifications are off for Unreel" = "Mitteilungen sind für Unreel aus";
"Open Settings" = "Einstellungen öffnen";
"Cancel" = "Abbrechen";
"Allow notifications for Unreel in the Settings app to get message alerts." = "Erlaube Mitteilungen für Unreel in den Einstellungen, um Nachrichten-Hinweise zu bekommen.";
"Sent you a message" = "Hat dir eine Nachricht gesendet";
"New messages" = "Neue Nachrichten";
"You have %lld unread chats" = "Du hast %lld ungelesene Chats";
"Last background check" = "Letzte Prüfung im Hintergrund";
"Background checks so far" = "Bisherige Prüfungen";
"Not yet" = "Noch nicht";
"The last check found you logged out. Open Unreel and log in to Instagram." = "Bei der letzten Prüfung warst du abgemeldet. Öffne Unreel und melde dich bei Instagram an.";
"The last check couldn't load your inbox in time. It will try again." = "Die letzte Prüfung konnte deine Nachrichten nicht rechtzeitig laden. Sie versucht es erneut.";
"Instagram changed its inbox page. A fix will arrive automatically." = "Instagram hat seine Nachrichtenseite geändert. Eine Korrektur kommt automatisch.";
"Tap here to open Unreel." = "Tippe hier, um Unreel zu öffnen.";

/* Setup guides */
"How to set it up" = "So richtest du es ein";
"Set it up" = "Einrichten";
"Open Unreel from Instagram" = "Unreel aus Instagram öffnen";
"With a Shortcuts automation, opening Instagram or tapping one of its notifications takes you straight to Unreel. Takes about a minute." = "Mit einer Kurzbefehle-Automation landest du beim Öffnen von Instagram oder beim Tippen auf eine seiner Mitteilungen direkt in Unreel. Dauert etwa eine Minute.";
"Open Shortcuts" = "Kurzbefehle öffnen";
"Close" = "Schließen";
"Step %lld" = "Schritt %lld";
"Turn on the lock" = "Sperre einschalten";
"In Unreel, tap ≡, then turn on Lock the Instagram app." = "Tippe in Unreel auf ≡ und schalte Instagram-App sperren ein.";
"Allow Screen Time" = "Bildschirmzeit erlauben";
"Pick Instagram" = "Instagram auswählen";
"That's it" = "Das war's";
"Tap Continue, confirm with Face ID or your passcode, then allow notifications." = "Tippe auf Fortfahren, bestätige mit Face ID oder deinem Code und erlaube Mitteilungen.";
"Tap Choose Activities, open Social, tick Instagram, then tap Done." = "Tippe auf Aktivitäten wählen, öffne Soziale Netze, hake Instagram an und tippe auf Fertig.";
"The lock is on. Opening Instagram now shows a screen with an Open Unreel button." = "Die Sperre ist an. Beim Öffnen von Instagram erscheint jetzt ein Bildschirm mit der Taste Unreel öffnen.";
"Start an automation" = "Automation erstellen";
"In Shortcuts, tap +. Tap Automation, scroll down and tap App." = "Tippe in Kurzbefehle auf +. Tippe auf Automation, scrolle nach unten und tippe auf App.";
"In When App is Opened, tap App and choose Instagram." = "Tippe bei Wenn App geöffnet wird auf App und wähle Instagram.";
"Add the Open App action, tap App and choose Unreel." = "Füge die Aktion App öffnen hinzu, tippe auf App und wähle Unreel.";
