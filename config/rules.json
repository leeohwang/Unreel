{
  "version": 4,
  "redirectPath": "/direct/inbox/",
  "minutesPerBlockedVisit": 2,
  "blockedPaths": [
    { "pattern": "^/reels?(/|$)", "kind": "reels" },
    { "pattern": "^/[^/]+/reels?(/|$)", "kind": "reels" },
    { "pattern": "^/explore/?$", "kind": "explore", "redirect": "/explore/search/", "count": false },
    { "pattern": "^/explore/(?!search)", "kind": "explore" },
    { "pattern": "^/?$", "kind": "feed", "count": false }
  ],
  "hideSelectors": [
    "a[href=\"/reels/\"]",
    "a[href$=\"/reels/\"]",
    "a[href*=\"/reel/\"]",
    "[data-visualcompletion=\"ignore-dynamic\"] > div:has(a[href=\"/reels/\"])"
  ],
  "feedSelectors": [
    "a[href=\"/\"]",
    "[data-visualcompletion=\"ignore-dynamic\"] > div:has(a[href=\"/\"])"
  ],
  "igBarLinks": [
    "a[href=\"/explore/\"]",
    "a[href=\"/direct/inbox/\"]"
  ],
  "extraCSS": "html[data-unreel-path^=\"/direct/\"] [role=\"navigation\"] > div { border-right-width: 0 !important; }\nhtml[data-unreel-path=\"/direct/inbox/\"] [role=\"navigation\"] [role=\"button\"]:has(svg[aria-label=\"Back\"]) { visibility: hidden !important; pointer-events: none !important; }"
}
